# Copy to .env on the EC2 host. Do not commit real values.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET=replace-with-another-long-random-string
DEBUG=false

POSTGRES_DB=parcelpilot
POSTGRES_USER=parcelpilot
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Public Elastic IP only (no http:// on ALLOWED_HOSTS).
ALLOWED_HOSTS=YOUR.ELASTIC.IP
CORS_ALLOWED_ORIGINS=http://YOUR.ELASTIC.IP
CSRF_TRUSTED_ORIGINS=http://YOUR.ELASTIC.IP

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_MOCK_EMBEDDINGS=true
DATASET_REFERENCE_TIME=2026-08-16T11:00:00+05:30
PENDING_ACTION_TTL_MINUTES=30
SECURE_SSL_REDIRECT=false
